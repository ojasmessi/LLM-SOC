{
  "rest": {
    "RestGenerator": {
      "name": "llm-soc-chatbot",
      "uri": "http://localhost:8000/chat",
      "method": "post",
      "headers": {"Content-Type": "application/json"},
      "req_template_json_object": {"user": "garak", "message": "$INPUT"},
      "response_json": true,
      "response_json_field": "reply",
      "request_timeout": 300
    }
  }
}
